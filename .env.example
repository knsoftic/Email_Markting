APP_NAME="KN Softic"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=knsoftic_mail
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# System mailer — used only for password resets, verification and internal
# notifications. Campaign + inbox mail uses per-account SMTP records in the DB.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@knsoftic.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ----------------------------------------------------------------------------
# KN Softic platform settings
# ----------------------------------------------------------------------------
# How many recipient jobs are pushed per campaign batch chunk.
KNS_CAMPAIGN_CHUNK=500
# Max emails dispatched per minute across the whole install (throttle guard).
KNS_SEND_RATE_PER_MINUTE=120
# Minutes between automatic IMAP syncs for an active mailbox.
KNS_MAILBOX_SYNC_MINUTES=5
# Max messages pulled from a mailbox in a single sync pass.
KNS_MAILBOX_SYNC_LIMIT=100
# Max attachment size accepted on compose/upload, in kilobytes.
KNS_MAX_ATTACHMENT_KB=10240
# Consecutive SMTP failures before an account is put in cooldown.
KNS_SMTP_FAILURE_THRESHOLD=5
# Cooldown length in minutes once the failure threshold is hit.
KNS_SMTP_COOLDOWN_MINUTES=30
# Hard bounces tolerated for an address before it is auto-suppressed.
KNS_HARD_BOUNCE_LIMIT=1
# Open/click tracking master switch (per-campaign toggles still apply).
KNS_TRACKING_ENABLED=true

# ----------------------------------------------------------------------------
# First super admin (used by SuperAdminSeeder only)
# ----------------------------------------------------------------------------
KNS_ADMIN_NAME="KN Softic Admin"
KNS_ADMIN_EMAIL=admin@knsoftic.com
KNS_ADMIN_PASSWORD=change-this-before-deploying
